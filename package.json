        "@ylfjuk/md": "^0.0.3",
        "knip": "^6.31.0",
        "oxfmt": "^0.61.0",
        "oxlint": "^1.77.0",
        "tsdown": "^0.22.14",
        "turbo": "^2.10.10",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    },
