{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"test": {
			"with": ["test:types"],
			"dependsOn": ["^test:types", "^test"]
		},
		"test:types": {
			"dependsOn": ["^test:types"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		}
	}
}
