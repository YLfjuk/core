{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalDependencies": ["tsconfig.base.json"],
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"test": {
			"dependsOn": ["^test"]
		},
		"test:types": {
			"dependsOn": ["^test:types"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		}
	}
}
