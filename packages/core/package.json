{
    "name": "@ylfjuk/core",
    "version": "0.0.19",
    "description": "The core packages",
    "author": "YLfjuk",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/YLfjuk/core.git",
        "directory": "packages/core"
    },
    "keywords": [
        "ylfjuk",
        "core"
    ],
    "files": [
